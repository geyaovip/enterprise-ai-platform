{
  "name": "enterprise-ai-platform",
  "account_id": "be17a247378b4f5d64bc2eb9075eaa0f",
  "main": "cloudflare/worker.js",
  "compatibility_date": "2026-09-30",
  "workers_dev": true,
  "routes": [
    { "pattern": "zhixingark.cn", "custom_domain": true },
    { "pattern": "www.zhixingark.cn", "custom_domain": true }
  ],
  "services": [
    { "binding": "WORKSPACE", "service": "enterprise-ai-platform-workspace" },
    { "binding": "TENANT_ADMIN", "service": "enterprise-ai-platform-tenant-admin" },
    { "binding": "PLATFORM_ADMIN", "service": "enterprise-ai-platform-platform-admin" }
  ]
}
