  id String @id @default(uuid())
  tenantId String
  projectId String
  project GeoProject @relation(fields:[projectId,tenantId],references:[id,tenantId])
  createdByMembershipId String
  userId String
  requestKey String
  requestHash String
  status String @default("queued")
  snapshot Json
  comparabilityHash String
  estimatedCostMicros Int
  actualCostMicros Int?
  report Json?
  baselineId String?
  optimizationId String?
  cancelRequested Boolean @default(false)
  leaseUntil DateTime?
  leaseToken String?
  errorCode String?
  version Int @default(1)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  finishedAt DateTime?
  runs GeoRun[]
  @@unique([id,tenantId])
  @@unique([tenantId,requestKey])
  @@index([status,leaseUntil,createdAt])
  @@index([tenantId,projectId,createdAt])
}
model GeoRun {
  id String @id @default(uuid())
  tenantId String
  analysisId String
  analysis GeoAnalysis @relation(fields:[analysisId,tenantId],references:[id,tenantId])
  questionId String
  modelId String
  modelVersionId String
  status String @default("queued")
  attempts Int @default(0)
  retryAt DateTime?
  question Json
  model Json
  text String?
  citations Json?
  parsed Json?
  validSample Boolean @default(false)
  inputTokens Int?
  outputTokens Int?
  actualCostMicros Int?
  estimatedCostMicros Int
  durationMs Int?
  externalId String?
  errorCode String?
  startedAt DateTime?
  finishedAt DateTime?
  @@unique([analysisId,questionId,modelId])
  @@index([tenantId,analysisId,status])
}
model GeoSchedule {
  id String @id @default(uuid())
  tenantId String
  projectId String
  project GeoProject @relation(fields:[projectId,tenantId],references:[id,tenantId])
  createdByMembershipId String
  userId String
  name String
  active Boolean @default(true)
  frequency String
  hour Int
  minute Int
  weekday Int @default(1)
  timezone String
  questionIds String[]
  modelIds String[]
  maxCostMicros Int
  nextRunAt DateTime
  version Int @default(1)
  requestKey String
  requestHash String
  createdAt DateTime @default(now())
  executions GeoScheduleExecution[]
  @@unique([id,tenantId])
  @@unique([tenantId,requestKey])
  @@index([active,nextRunAt])
}
model GeoScheduleExecution {
  id String @id @default(uuid())
  tenantId String
  scheduleId String
  schedule GeoSchedule @relation(fields:[scheduleId,tenantId],references:[id,tenantId])
  dueAt DateTime
  status String @default("pending")
  snapshot Json
  attempts Int @default(0)
  retryAt DateTime?
  analysisId String?
  errorCode String?
  leaseUntil DateTime?
  createdAt DateTime @default(now())
  @@unique([scheduleId,dueAt])
  @@index([status,retryAt,leaseUntil])
}
model GeoOptimization {
  id String @id @default(uuid())
  tenantId String
  projectId String
  project GeoProject @relation(fields:[projectId,tenantId],references:[id,tenantId])
  title String
  description String
  baselineId String
  sourceRunId String?
  assigneeMembershipId String?
  evidenceUrl String?
  dueAt DateTime?
  status String @default("open")
  version Int @default(1)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([tenantId,projectId,status])
  @@index([tenantId,assigneeMembershipId,status])
}

model ManufacturingItem {
  tenantId   String
  materialId String
  productId  String
  @@id([tenantId, materialId])
  @@unique([tenantId, productId])
}

model ManufacturingOrder {
  id           String   @id @default(uuid())
  tenantId     String
  number       String
  customerId   String
  productId    String
  warehouseId  String
  customerName String
  productName  String
  sku          String
  createdBy    String
  quantity     Int
  salesStatus String @default("confirmed")
  salesReviewNote String?
  completedQty Int      @default(0)
  shippedQty   Int      @default(0)
  version      Int      @default(1)
  bomId        String
  bomRevision  Int
  bomVersions  Json
  dueDate      String?
  createdAt    DateTime @default(now())
  requirements ManufacturingRequirement[]
  purchases    ManufacturingPurchase[]
  plan ManufacturingPlan?
  materialUses ManufacturingMaterialUse[]
  @@unique([tenantId, number])
  @@index([tenantId, createdAt])
}

model ManufacturingRequirement {
  orderId    String
  productId  String
  sku        String
  name       String
  unit       String
  quantity   Decimal @db.Decimal(18, 3)
  issued     Decimal @default(0) @db.Decimal(18, 3)
  consumed   Decimal @default(0) @db.Decimal(18, 3)
  wipValue   Decimal @default(0) @db.Decimal(18, 2)
  order      ManufacturingOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  @@id([orderId, productId])
}

model ManufacturingPurchase {
  purchaseId String @id
  orderId    String
  order      ManufacturingOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  @@index([orderId])
}

model ManufacturingReceipt {
  tenantId     String
  membershipId String
  requestKey   String
  fingerprint  String
  result       Json
  createdAt    DateTime @default(now())
  @@id([tenantId, membershipId, requestKey])
}

model ErpStockHold {
  tenantId    String
  warehouseId String
  productId   String
  orderId     String
  quantity    Decimal @db.Decimal(18, 6)
  @@id([tenantId, warehouseId, productId, orderId])
  @@index([tenantId, orderId])
}

model ErpTrackedStock {
  tenantId    String
  warehouseId String
  productId   String
  code        String
  kind        String
  quantity    Decimal @db.Decimal(18, 6)
  @@id([tenantId, warehouseId, productId, code])
  @@index([tenantId, code])
}

model ManufacturingPlan {
  id          String @id @default(uuid())
  orderId     String @unique
  order       ManufacturingOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  startDate   String
  dueDate     String
  status      String @default("draft")
  version     Int    @default(1)
  jobs        ManufacturingJob[]
}

model ManufacturingJob {
  id          String @id @default(uuid())
  planId      String
  plan        ManufacturingPlan @relation(fields: [planId], references: [id], onDelete: Cascade)
  assigneeId  String
  quantity    Int
  label       String
  createdAt   DateTime @default(now())
  reports     ManufacturingReport[]
  @@index([planId])
}

model ManufacturingReport {
  id          String @id @default(uuid())
  jobId       String
  job         ManufacturingJob @relation(fields: [jobId], references: [id], onDelete: Cascade)
  reporterId  String
  reviewerId  String?
  good        Int
  defective   Int
  status      String @default("pending")
  note        String?
  reviewNote  String?
  createdAt   DateTime @default(now())
  reviewedAt  DateTime?
  @@index([jobId, createdAt])
}

model ManufacturingMaterialUse {
  id         String @id @default(uuid())
  orderId    String
  order      ManufacturingOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  documentId String
  productId  String
  code       String?
  kind       String?
  quantity   Decimal @db.Decimal(18, 3)
  @@index([orderId, productId])
  @@index([documentId])
}

model ManufacturingMemberGrant {
  tenantId     String
  membershipId String
  role         String
  @@id([tenantId, membershipId])
}

model ManufacturingWarehousePurchase {
  purchaseId  String @id
  tenantId    String
  warehouseId String
  createdAt   DateTime @default(now())
  @@index([tenantId, warehouseId, createdAt])
}
