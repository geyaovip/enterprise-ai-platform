generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

// WorkBuddy: a separate grant for each application/resource and current member.
model ConnectorClient {
  id String @id @default(uuid())
  name String
  redirectUris Json
  createdAt DateTime @default(now())
}

model ConnectorAuthorization {
  id String @id @default(uuid())
  clientId String
  redirectUri String
  appId String
  resource String
  scopes Json
  state String?
  challenge String
  consentUserId String?
  consentHash String?
  codeHash String? @unique
  grantId String?
  consumedAt DateTime?
  deniedAt DateTime?
  expiresAt DateTime
  createdAt DateTime @default(now())
  @@index([expiresAt])
}

model ConnectorGrant {
  id String @id @default(uuid())
  clientId String
  userId String
  tenantId String
  membershipId String
  appId String
  resource String
  scopes Json
  expiresAt DateTime
  revokedAt DateTime?
  lastUsedAt DateTime?
  createdAt DateTime @default(now())
  @@index([userId, createdAt])
  @@index([tenantId, membershipId])
}

model ConnectorToken {
  id String @id @default(uuid())
  hash String @unique
  grantId String
  kind String
  expiresAt DateTime
  usedAt DateTime?
  createdAt DateTime @default(now())
  @@index([grantId, kind])
  @@index([expiresAt])
}

model ConnectorAction {
  id String @id @default(uuid())
  grantId String
  tenantId String
  userId String
  membershipId String
  appId String
  command String
  requestKey String
  input Json
  preview Json
  fingerprint String
  requestFingerprint String
  status String @default("pending")
  version Int @default(1)
  result Json?
  confirmedAt DateTime?
  expiresAt DateTime
  createdAt DateTime @default(now())
  @@unique([grantId, requestKey])
  @@index([tenantId, userId, createdAt])
}

model ConnectorRate {
  key String @id
  count Int @default(1)
  expiresAt DateTime
}

datasource db {
  provider = "postgresql"
}

model Tenant {
  contentCanvasRows ContentCanvas[]
  contentGrantRows ContentGrant[]
  contentSettingsRows ContentSettings[]
  contentDocumentRows ContentDocument[]
  contentDocumentVersionRows ContentDocumentVersion[]
  contentProjectRows ContentProject[]
  contentAssetRows ContentAsset[]
  contentMediaJobRows ContentMediaJob[]
  contentArtifactRows ContentArtifact[]
  contentArtifactVersionRows ContentArtifactVersion[]
  contentBatchRows ContentBatch[]
  contentGenerationItemRows ContentGenerationItem[]
  contentProviderAttemptRows ContentProviderAttempt[]
  contentExportRows ContentExport[]
  contentWorkDraftRows ContentWorkDraft[]
  contentCopySuggestionRows ContentCopySuggestion[]
  id        String              @id @default(uuid())
  slug      String              @unique
  name      String
  active    Boolean             @default(true)
  createdAt DateTime            @default(now())
  members   Membership[]
  orgUnits  OrgUnit[]
  apps      TenantApp[]
  audits    AuditEvent[]
  channels  ChannelConnection[]
  erpWorkflows ErpWorkflow[]
  selfServiceOwnerId String? @unique
  selfServiceOwner User? @relation(fields: [selfServiceOwnerId], references: [id])
}

model User {
  id           String       @id @default(uuid())
  email        String?      @unique
  account      String?      @unique
  name         String
  passwordHash String
  emailVerifiedAt DateTime?
  platformRole String?
  active       Boolean      @default(true)
  createdAt    DateTime     @default(now())
  memberships  Membership[]
  sessions     Session[]
  createdTenant Tenant?
}

model Membership {
  id                String                @id @default(uuid())
  tenantId          String
  tenant            Tenant                @relation(fields: [tenantId], references: [id])
  userId            String
  user              User                  @relation(fields: [userId], references: [id])
  role              String
  active            Boolean               @default(true)
  createdAt         DateTime              @default(now())
  orgs              MembershipOrg[]
  createdTasks      ErpTask[]             @relation("ErpTaskCreator")
  assignedTasks     ErpTask[]             @relation("ErpTaskAssignee")
  notifications     ErpNotification[]
  announcements     ErpAnnouncement[]
  announcementReads ErpAnnouncementRead[]

  @@unique([tenantId, userId])
  @@unique([id, tenantId])
  @@index([userId, active])
}

model OrgUnit {
  id        String          @id @default(uuid())
  tenantId  String
  tenant    Tenant          @relation(fields: [tenantId], references: [id])
  parentId  String?
  parent    OrgUnit?        @relation("OrgTree", fields: [parentId], references: [id])
  children  OrgUnit[]       @relation("OrgTree")
  name      String
  active    Boolean         @default(true)
  version   Int             @default(1)
  createdAt DateTime        @default(now())
  members   MembershipOrg[]

  @@unique([id, tenantId])
  @@index([tenantId, parentId])
}

model MembershipOrg {
  tenantId     String
  membershipId String
  membership   Membership @relation(fields: [membershipId, tenantId], references: [id, tenantId])
  orgUnitId    String
  orgUnit      OrgUnit    @relation(fields: [orgUnitId, tenantId], references: [id, tenantId])
  primary      Boolean    @default(false)

  @@id([membershipId, orgUnitId])
  @@index([tenantId, orgUnitId])
}

model TenantApp {
  id        String   @id @default(uuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id])
  appId     String
  enabled   Boolean  @default(true)
  granted   Boolean  @default(true)
  createdAt DateTime @default(now())

  @@unique([tenantId, appId])
}

model Session {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId, expiresAt])
}

model AuditEvent {
  id           String   @id @default(uuid())
  tenantId     String
  tenant       Tenant   @relation(fields: [tenantId], references: [id])
  userId       String
  membershipId String
  appId        String
  requestId    String
  action       String
  resourceType String
  resourceId   String
  detail       Json?
  createdAt    DateTime @default(now())

  @@index([tenantId, appId, resourceType, resourceId, createdAt])
  @@index([requestId])
}

model ChannelConnection {
  id               String            @id @default(uuid())
  tenantId         String
  tenant           Tenant            @relation(fields: [tenantId], references: [id])
  provider         String
  appId            String
  secretCiphertext String
  status           String            @default("configured")
  lastError        String?
  connectedAt      DateTime?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  cursor           String?
  identities       ChannelIdentity[]
  deliveries       ChannelDelivery[]

  @@unique([tenantId, provider])
  @@unique([provider, appId])
}

model ChannelConnectAttempt {
  id           String    @id @default(uuid())
  tenantId     String
  membershipId String
  provider     String
  status       String    @default("starting")
  qrUrl        String?
  stateCiphertext String?
  pollAfter    DateTime?
  expiresAt    DateTime?
  errorCode    String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([tenantId, membershipId, createdAt])
}

model ChannelIdentity {
  id             String            @id @default(uuid())
  tenantId       String
  connectionId   String
  connection     ChannelConnection @relation(fields: [connectionId], references: [id])
  membershipId   String
  externalUserId String
  appId          String            @default("erp")
  createdAt      DateTime          @default(now())

  @@unique([connectionId, membershipId])
  @@unique([connectionId, externalUserId])
  @@index([tenantId, membershipId])
}

model ChannelPairCode {
  id           String    @id @default(uuid())
  tenantId     String
  connectionId String
  membershipId String
  codeHash     String    @unique
  expiresAt    DateTime
  usedAt       DateTime?
  createdAt    DateTime  @default(now())

  @@index([tenantId, membershipId, createdAt])
}

model ChannelChatSession {
  id             String   @id @default(uuid())
  tenantId       String
  connectionId   String
  membershipId   String
  externalChatId String
  appId          String   @default("erp")
  conversationId String
  createdAt      DateTime @default(now())

  @@unique([connectionId, externalChatId, membershipId, appId])
}

model ChannelInbound {
  id            String   @id @default(uuid())
  connectionId  String
  messageId     String
  senderId      String
  chatId        String
  chatType      String
  content       String
  status        String   @default("queued")
  attempts      Int      @default(0)
  nextAttemptAt DateTime @default(now())
  replyText     String?
  contextCiphertext String?
  replyMembershipId String?
  replyAppId    String?
  aiStartedAt   DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([connectionId, messageId])
  @@index([status, nextAttemptAt])
}

model ChannelDelivery {
  id                String            @id @default(uuid())
  tenantId          String
  connectionId      String
  connection        ChannelConnection @relation(fields: [connectionId], references: [id])
  membershipId      String
  eventKey          String
  title             String
  body              String
  status            String            @default("queued")
  attempts          Int               @default(0)
  nextAttemptAt     DateTime          @default(now())
  providerMessageId String?
  errorCode         String?
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
  sentAt            DateTime?

  @@unique([connectionId, membershipId, eventKey])
  @@index([status, nextAttemptAt])
}

model ErpCustomer {
  id                String               @id @default(uuid())
  tenantId          String
  code              String
  name              String
  contactName       String?
  phone             String?
  industry          String?
  address           String?
  taxNumber         String?
  paymentDays       Int                  @default(0)
  creditLimit       Decimal?             @db.Decimal(18, 2)
  ownerMembershipId String?
  active            Boolean              @default(true)
  createdAt         DateTime             @default(now())
  opportunities     ErpOpportunity[]
  contracts         ErpSalesContract[]
  incomingReceipts  ErpIncomingReceipt[]

  @@unique([tenantId, code])
  @@index([tenantId, ownerMembershipId])
}

model ErpOpportunity {
  id                String                   @id @default(uuid())
  tenantId          String
  customerId        String
  customer          ErpCustomer              @relation(fields: [customerId], references: [id])
  name              String
  stage             String                   @default("discovery")
  estimatedAmount   Decimal                  @db.Decimal(18, 2)
  ownerMembershipId String
  createdAt         DateTime                 @default(now())
  updatedAt         DateTime                 @updatedAt
  contracts         ErpSalesContract[]
  followups         ErpOpportunityFollowup[]

  @@index([tenantId, ownerMembershipId, stage])
}

model ErpOpportunityFollowup {
  id                String         @id @default(uuid())
  tenantId          String
  opportunityId     String
  opportunity       ErpOpportunity @relation(fields: [opportunityId], references: [id])
  actorMembershipId String
  note              String
  nextActionAt      DateTime?
  createdAt         DateTime       @default(now())

  @@index([tenantId, opportunityId, createdAt])
  @@index([tenantId, nextActionAt])
}

model ErpProduct {
  id            String               @id @default(uuid())
  tenantId      String
  sku           String
  name          String
  category      String?
  unit          String               @default("件")
  salePrice     Decimal              @db.Decimal(18, 2)
  purchasePrice Decimal              @db.Decimal(18, 2)
  reorderPoint  Float                @default(0)
  active        Boolean              @default(true)
  createdAt     DateTime             @default(now())
  balance       ErpInventoryBalance?
  purchaseLines ErpPurchaseLine[]
  salesLines    ErpSalesLine[]

  @@unique([tenantId, sku])
}

model ErpSupplier {
  id          String             @id @default(uuid())
  tenantId    String
  code        String
  name        String
  contactName String?
  phone       String?
  address     String?
  taxNumber   String?
  paymentDays Int                @default(0)
  active      Boolean            @default(true)
  createdAt   DateTime           @default(now())
  purchases   ErpPurchaseOrder[]

  @@unique([tenantId, code])
}

model ErpPurchaseOrder {
  id                    String              @id @default(uuid())
  tenantId              String
  number                String
  supplierId            String
  supplier              ErpSupplier         @relation(fields: [supplierId], references: [id])
  status                String              @default("draft")
  total                 Decimal             @db.Decimal(18, 2)
  note                  String?
  version               Int                 @default(1)
  dueAt                 DateTime?
  deliveryAt            DateTime?
  deliveryAddress       String?
  paymentTerms          String?
  closeReason           String?
  createdByMembershipId String
  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt
  lines                 ErpPurchaseLine[]
  changes               ErpPurchaseChange[]
  payable               ErpPayable?

  @@unique([tenantId, number])
  @@index([tenantId, status])
}

model ErpPurchaseChange {
  id                      String           @id @default(uuid())
  tenantId                String
  orderId                 String
  order                   ErpPurchaseOrder @relation(fields: [orderId], references: [id])
  baseVersion             Int
  status                  String           @default("pending")
  reason                  String
  reviewReason            String?
  before                  Json
  proposed                Json
  requestedByMembershipId String
  reviewedByMembershipId  String?
  createdAt               DateTime         @default(now())
  reviewedAt              DateTime?

  @@index([tenantId, orderId, createdAt])
  @@index([tenantId, status, createdAt])
}

model ErpPurchaseLine {
  id              String           @id @default(uuid())
  orderId         String
  order           ErpPurchaseOrder @relation(fields: [orderId], references: [id])
  productId       String
  product         ErpProduct       @relation(fields: [productId], references: [id])
  sku             String
  name            String
  quantity        Float
  receivedQty     Float            @default(0)
  unitPrice       Decimal          @db.Decimal(24, 6)
  basePrice       Decimal?         @db.Decimal(18, 2)
  discountPercent Decimal          @default(0) @db.Decimal(6, 3)
  taxRate         Decimal          @default(0) @db.Decimal(6, 3)
  taxIncluded     Boolean          @default(true)
  unit            String           @default("件")
  unitFactor      Float            @default(1)
  lineTotal       Decimal          @db.Decimal(18, 2)
  baseUnit String @default("件")
}

model ErpSalesContract {
  id                String              @id @default(uuid())
  tenantId          String
  number            String
  customerId        String
  customer          ErpCustomer         @relation(fields: [customerId], references: [id])
  opportunityId     String?
  opportunity       ErpOpportunity?     @relation(fields: [opportunityId], references: [id])
  ownerMembershipId String
  status            String              @default("draft")
  total             Decimal             @db.Decimal(18, 2)
  note              String?
  version           Int                 @default(1)
  dueAt             DateTime?
  deliveryAt        DateTime?
  deliveryAddress   String?
  paymentTerms      String?
  closeReason       String?
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt
  lines             ErpSalesLine[]
  receivable        ErpReceivable?
  invoiceRequests   ErpInvoiceRequest[]

  @@unique([tenantId, number])
  @@index([tenantId, ownerMembershipId, status])
}

model ErpInvoiceRequest {
  id                      String           @id @default(uuid())
  tenantId                String
  contractId              String
  contract                ErpSalesContract @relation(fields: [contractId], references: [id])
  amount                  Decimal          @db.Decimal(18, 2)
  status                  String           @default("requested")
  note                    String?
  requestedByMembershipId String
  reviewedByMembershipId  String?
  reviewReason            String?
  invoiceNumber           String?
  registeredAt            DateTime?
  voidReference           String?
  createdAt               DateTime         @default(now())
  updatedAt               DateTime         @updatedAt

  @@unique([tenantId, invoiceNumber])
  @@index([tenantId, contractId, status])
  @@index([tenantId, status, createdAt])
}

model ErpSalesLine {
  id              String           @id @default(uuid())
  contractId      String
  contract        ErpSalesContract @relation(fields: [contractId], references: [id])
  productId       String
  product         ErpProduct       @relation(fields: [productId], references: [id])
  sku             String
  name            String
  quantity        Float
  shippedQty      Float            @default(0)
  unitPrice       Decimal          @db.Decimal(24, 6)
  basePrice       Decimal?         @db.Decimal(18, 2)
  discountPercent Decimal          @default(0) @db.Decimal(6, 3)
  taxRate         Decimal          @default(0) @db.Decimal(6, 3)
  taxIncluded     Boolean          @default(true)
  unit            String           @default("件")
  unitFactor      Float            @default(1)
  lineTotal       Decimal          @db.Decimal(18, 2)
  baseUnit String @default("件")
}

model ErpInventoryBalance {
  id             String     @id @default(uuid())
  tenantId       String
  productId      String     @unique
  product        ErpProduct @relation(fields: [productId], references: [id])
  quantity       Float      @default(0)
  version        Int        @default(1)
  updatedAt      DateTime   @updatedAt
  inventoryValue Decimal    @default(0) @db.Decimal(18, 2)
  costEstimated  Boolean    @default(false)

  openingAt DateTime?
  @@index([tenantId, productId])
}

model ErpStockDocument {
  id                String             @id @default(uuid())
  tenantId          String
  number            String
  kind              String
  sourceId          String
  note              String?
  actorMembershipId String
  createdAt         DateTime           @default(now())
  movements         ErpStockMovement[]

  @@unique([tenantId, number])
  @@index([tenantId, kind, sourceId, createdAt])
}

model ErpStockMovement {
  id                String           @id @default(uuid())
  tenantId          String
  productId         String
  direction         String
  quantity          Float
  sourceType        String
  sourceId          String
  documentId        String
  document          ErpStockDocument @relation(fields: [documentId], references: [id])
  actorMembershipId String
  createdAt         DateTime         @default(now())
  warehouseId       String?
  unitCost          Decimal?         @db.Decimal(30, 6)
  costAmount        Decimal?         @db.Decimal(18, 2)
  costEstimated     Boolean          @default(false)

  tradeAmount Decimal? @db.Decimal(18, 2)
  trackingCode String?
  trackingKind String?
  @@index([tenantId, trackingCode])
  @@index([tenantId, documentId, productId])
  @@index([tenantId, productId, createdAt])
  grossAmount Decimal? @db.Decimal(18, 2)
}

model ErpPayable {
  id               String            @id @default(uuid())
  tenantId         String
  orderId          String?           @unique
  order            ErpPurchaseOrder? @relation(fields: [orderId], references: [id])
  amount           Decimal           @db.Decimal(18, 2)
  supplierId       String?
  dueAt            DateTime?
  openingReference String?
  paidAmount       Decimal           @default(0) @db.Decimal(18, 2)
  status           String            @default("open")
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  payments         ErpPayment[]      @relation("PayablePayments")

  @@index([tenantId, status])
}

model ErpReceivable {
  id               String            @id @default(uuid())
  tenantId         String
  contractId       String?           @unique
  contract         ErpSalesContract? @relation(fields: [contractId], references: [id])
  amount           Decimal           @db.Decimal(18, 2)
  customerId       String?
  dueAt            DateTime?
  openingReference String?
  paidAmount       Decimal           @default(0) @db.Decimal(18, 2)
  status           String            @default("open")
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  payments         ErpPayment[]      @relation("ReceivablePayments")

  @@index([tenantId, status])
}

model ErpPayment {
  id                String           @id @default(uuid())
  tenantId          String
  receivableId      String?
  receivable        ErpReceivable?   @relation("ReceivablePayments", fields: [receivableId], references: [id])
  payableId         String?
  payable           ErpPayable?      @relation("PayablePayments", fields: [payableId], references: [id])
  amount            Decimal          @db.Decimal(18, 2)
  reference         String
  kind              String           @default("payment")
  reversalOfId      String?          @unique
  reversedAt        DateTime?
  note              String?
  advanceId         String?
  actorMembershipId String
  receiptClaimId    String?
  receiptClaim      ErpReceiptClaim? @relation(fields: [receiptClaimId], references: [id])
  createdAt         DateTime         @default(now())

  @@unique([tenantId, receivableId, reference])
  @@unique([tenantId, payableId, reference])
  @@unique([tenantId, advanceId, reference])
  @@index([receiptClaimId])
}

model ErpIncomingReceipt {
  id                       String            @id @default(uuid())
  tenantId                 String
  customerId               String
  customer                 ErpCustomer       @relation(fields: [customerId], references: [id])
  reference                String
  amount                   Decimal           @db.Decimal(18, 2)
  allocatedAmount          Decimal           @default(0) @db.Decimal(18, 2)
  status                   String            @default("open")
  version                  Int               @default(1)
  receivedAt               DateTime
  note                     String?
  registeredByMembershipId String
  cancelReason             String?
  createdAt                DateTime          @default(now())
  updatedAt                DateTime          @updatedAt
  claims                   ErpReceiptClaim[]

  @@unique([tenantId, reference])
  @@index([tenantId, customerId, status])
}

model ErpReceiptClaim {
  id                      String             @id @default(uuid())
  tenantId                String
  receiptId               String
  receipt                 ErpIncomingReceipt @relation(fields: [receiptId], references: [id])
  baseVersion             Int
  status                  String             @default("pending")
  amount                  Decimal            @db.Decimal(18, 2)
  allocations             Json
  requestedByMembershipId String
  reviewedByMembershipId  String?
  reviewReason            String?
  createdAt               DateTime           @default(now())
  reviewedAt              DateTime?
  payments                ErpPayment[]

  @@index([tenantId, receiptId, status])
  @@index([tenantId, status, createdAt])
}

model AiProviderSettings {
  tenantId      String   @id
  model         String
  baseUrl       String
  keyCiphertext String
  updatedBy     String
  updatedAt     DateTime @updatedAt
}

model AiConversation {
  id           String   @id @default(uuid())
  tenantId     String
  userId       String
  appId        String
  resourceType String?
  resourceId   String?
  title        String
  messages     Json     @default("[]")
  version      Int      @default(1)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  summary      AiContextSummary?

  @@index([tenantId, userId, appId, updatedAt])
}

model AiContextSummary {
  conversationId String @id
  conversation AiConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  coveredMessages Int
  sourceDigest String
  scopeDigest String
  content String
  updatedAt DateTime @updatedAt
}

model AiMemoryEntry {
  id String @id @default(uuid())
  tenantId String
  appId String
  ownerUserId String?
  createdByUserId String
  visibility String
  kind String
  title String
  content String
  version Int @default(1)
  expiresAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([tenantId, appId, ownerUserId, updatedAt])
}

model AiMemorySetting {
  tenantId String
  userId String
  appId String
  enabled Boolean @default(true)
  updatedAt DateTime @updatedAt
  @@id([tenantId, userId, appId])
}

model AiAction {
  id                   String   @id @default(uuid())
  tenantId             String
  userId               String
  membershipId         String
  appId                String
  conversationId       String
  toolId               String
  input                Json
  status               String
  confirmationRequired Boolean
  result               Json?
  errorCode            String?
  idempotencyKey       String
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  @@unique([tenantId, idempotencyKey])
  @@index([tenantId, userId, status, createdAt])
}

model AiUsage {
  id           String   @id @default(uuid())
  tenantId     String
  userId       String
  appId        String
  model        String
  inputTokens  Int?
  outputTokens Int?
  status       String
  createdAt    DateTime @default(now())

  @@index([tenantId, appId, createdAt])
}

// Independent of conversations/memberships: deleting a conversation or leaving a
// tenant must not restore an account's lifetime trial allowance.
model AiChatTurn {
  userId    String
  turnKey   String
  taskId    String?  @unique
  status    String   @default("reserved")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@id([userId, turnKey])
  @@index([userId, status])
}

model AiTask {
  id           String    @id @default(uuid())
  tenantId     String
  userId       String
  membershipId String
  appId        String
  kind         String
  requestKey   String?
  input        Json
  status       String    @default("queued")
  result       Json?
  errorCode    String?
  attempts     Int       @default(0)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  startedAt    DateTime?
  finishedAt   DateTime?

  @@index([status, createdAt])
  @@index([tenantId, userId, appId, createdAt])
  @@unique([tenantId, membershipId, requestKey])
}

model PersonalNotification {
  id                    String   @id @default(uuid())
  tenantId              String
