POSTGRES_PASSWORD=change-me
DATABASE_URL=postgresql://suite_dev:change-me@127.0.0.1:54329/suite_dev
PORT=4600
WEB_ORIGIN=http://127.0.0.1:4601
AI_ENCRYPTION_KEY=base64-encoded-32-random-bytes
CHANNEL_ENCRYPTION_KEY=base64-encoded-32-random-bytes
# Required in production: comma-separated HTTPS model provider hostnames.
AI_PROVIDER_ALLOWED_HOSTS=

# All browser origins are explicit; production normally serves the three frontends on one origin.
# WEB_ORIGINS=http://127.0.0.1:4601,http://127.0.0.1:4603,http://127.0.0.1:4604
# Allow only the actual private component hostnames/IPs. Credentials are encrypted in the platform DB.
INFRASTRUCTURE_ALLOWED_HOSTS=your-openclaw-host,cloud.ragflow.io
KNOWLEDGE_STORAGE_DIR=var/knowledge

# Native knowledge parser binaries (defaults shown); no embedded local LLM required.
# KNOWLEDGE_PYTHON_PATH=python3
# KNOWLEDGE_PDFTOTEXT_PATH=pdftotext
# KNOWLEDGE_TESSERACT_PATH=tesseract
# KNOWLEDGE_PDFTOPPM_PATH=pdftoppm
# Add the actual embedding API hostname to INFRASTRUCTURE_ALLOWED_HOSTS when enabling native.

# Optional: explicit service enterprise for platform operator AI; operator must be its admin.
PLATFORM_AI_TENANT_KEY=

# Optional private OpenClaw memory-core bridge; never expose publicly.
MEMORY_CORE_URL=
MEMORY_CORE_TOKEN=

# CRM-only AI release gate; false keeps manual CRM available while model acceptance is pending.
CRM_AI_RELEASE_ENABLED=true

# Development only; production gate is explicit in .env.production.example.
MES_AI_RELEASE_ENABLED=true
