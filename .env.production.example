# Copy to .env.production and replace all change-me values before deployment.
# Use an HTTPS hostname for SITE_ADDRESS and WEB_ORIGIN in a customer environment.
RELEASE_TAG=change-me
SITE_ADDRESS=erp.example.com
BIND_ADDRESS=0.0.0.0
PUBLIC_HTTP_PORT=80
PUBLIC_HTTPS_PORT=443
POSTGRES_PASSWORD=change-me
DATABASE_URL=postgresql://suite:change-me@postgres:5432/suite
PORT=4600
WORKER_HEALTH_PORT=4602
WEB_ORIGIN=https://erp.example.com
AI_ENCRYPTION_KEY=change-me-base64-encoded-32-byte-key
CHANNEL_ENCRYPTION_KEY=change-me-base64-encoded-32-byte-key
AI_PROVIDER_ALLOWED_HOSTS=api.example-model-provider.com
