# Copy to .env.production and replace all change-me values before deployment.
# Use an HTTPS hostname for SITE_ADDRESS and WEB_ORIGIN in a customer environment.
RELEASE_TAG=change-me
SITE_ADDRESS=erp.example.com
BIND_ADDRESS=0.0.0.0
PUBLIC_HTTP_PORT=80
PUBLIC_HTTPS_PORT=443
POSTGRES_PASSWORD=change-me
DATABASE_URL=postgresql://suite:change-me@postgres:5432/suite
PORT=4600
WORKER_HEALTH_PORT=4602
WEB_ORIGIN=https://zhixingark.cn
AI_ENCRYPTION_KEY=change-me-base64-encoded-32-byte-key
CHANNEL_ENCRYPTION_KEY=change-me-base64-encoded-32-byte-key
AI_PROVIDER_ALLOWED_HOSTS=api.example-model-provider.com

# All browser origins are explicit; production normally serves the three frontends on one origin.
# WEB_ORIGINS=http://127.0.0.1:4601,http://127.0.0.1:4603,http://127.0.0.1:4604
# Allow only the actual private component hostnames/IPs. Credentials are encrypted in the platform DB.
INFRASTRUCTURE_ALLOWED_HOSTS=your-openclaw-host,cloud.ragflow.io
KNOWLEDGE_STORAGE_DIR=var/knowledge

# Native knowledge parser binaries (defaults shown); no embedded local LLM required.
# KNOWLEDGE_PYTHON_PATH=python3
# KNOWLEDGE_PDFTOTEXT_PATH=pdftotext
# Add the actual embedding API hostname to INFRASTRUCTURE_ALLOWED_HOSTS when enabling native.

# Optional private OpenClaw memory-core bridge; never expose publicly.
MEMORY_CORE_URL=
MEMORY_CORE_TOKEN=

# CRM-only AI release gate; false keeps manual CRM available while model acceptance is pending.
CRM_AI_RELEASE_ENABLED=true

# MES AI remains closed until a metered real-model acceptance is recorded.
MES_AI_RELEASE_ENABLED=true

# Formal browser origin and generated invitation links.
PUBLIC_WEB_ORIGIN=https://zhixingark.cn
PUBLIC_SITE_ORIGIN=https://zhixingark.cn

# Default BOM/order image intake uses the bundled local chi_sim+eng OCR.
# Direct vision requires independent acceptance and Runtime model capability.
AI_IMAGE_INTAKE_ENABLED=false

# Resend email-code authentication. Server only; never prefix these with VITE_.
RESEND_API_KEY=
AUTH_EMAIL_FROM=知行方舟 <no-reply@auth.zhixingark.cn>
# Stable random secret (at least 32 characters); keep across deployments.
AUTH_EMAIL_SECRET=
# Conservative budget until provider quota is confirmed.
AUTH_EMAIL_DAILY_LIMIT=80

# Optional API/worker image tag, separate from the frontend release tag.
# API_RELEASE_TAG=20261024-login-experience-r1

# Cloudflare Managed Turnstile. Secret is server-only; keep authentication HMAC unchanged.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
TURNSTILE_ALLOWED_HOSTNAMES=zhixingark.cn,www.zhixingark.cn,enterprise-ai-platform.492746023.workers.dev

# Native application models enabled with a lifetime 3-turn account trial; WorkBuddy uses its own model.
NATIVE_AI_MODEL_ENABLED=true
# Canonical public OAuth issuer and MCP resource origin (HTTPS, no path).
CONNECTOR_PUBLIC_ORIGIN=https://zhixingark.cn

# D-090: approved model for all native chat agents; lifetime trial = 3 turns/account.
NATIVE_CHAT_MODEL_ID=deepseek-v4-1-flash-economy-261017
KNOWLEDGE_MODEL_ENABLED=true
# KNOWLEDGE_PDFIMAGES_PATH=pdfimages

# Explicit platform text fallback. Uses platform Ark credentials, never another tenant profile.
NATIVE_CHAT_DEFAULT_ENABLED=false
# NATIVE_CHAT_API_KEY=platform-only-key

# Brand media tools. Configure on API and Worker using credentials for each service.
MEDIAKIT_API_KEY=
CONTENT_DOUBAO_VOICE_API_KEY=
