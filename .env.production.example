# Copy to .env.production and replace all change-me values before deployment.
# Use an HTTPS hostname for SITE_ADDRESS and WEB_ORIGIN in a customer environment.
RELEASE_TAG=change-me
SITE_ADDRESS=erp.example.com
BIND_ADDRESS=0.0.0.0
PUBLIC_HTTP_PORT=80
PUBLIC_HTTPS_PORT=443
POSTGRES_PASSWORD=change-me
DATABASE_URL=postgresql://suite:change-me@postgres:5432/suite
PORT=4600
WORKER_HEALTH_PORT=4602
WEB_ORIGIN=https://zhixingark.cn
AI_ENCRYPTION_KEY=change-me-base64-encoded-32-byte-key
CHANNEL_ENCRYPTION_KEY=change-me-base64-encoded-32-byte-key
AI_PROVIDER_ALLOWED_HOSTS=api.example-model-provider.com

# All browser origins are explicit; production normally serves the three frontends on one origin.
# WEB_ORIGINS=http://127.0.0.1:4601,http://127.0.0.1:4603,http://127.0.0.1:4604
# Allow only the actual private component hostnames/IPs. Credentials are encrypted in the platform DB.
INFRASTRUCTURE_ALLOWED_HOSTS=your-openclaw-host,cloud.ragflow.io
KNOWLEDGE_STORAGE_DIR=var/knowledge

# Native knowledge parser binaries (defaults shown); no embedded local LLM required.
# KNOWLEDGE_PYTHON_PATH=python3
# KNOWLEDGE_PDFTOTEXT_PATH=pdftotext
# Add the actual embedding API hostname to INFRASTRUCTURE_ALLOWED_HOSTS when enabling native.

# Optional private OpenClaw memory-core bridge; never expose publicly.
MEMORY_CORE_URL=
MEMORY_CORE_TOKEN=

# CRM-only AI release gate; false keeps manual CRM available while model acceptance is pending.
CRM_AI_RELEASE_ENABLED=false

# MES AI remains closed until a metered real-model acceptance is recorded.
MES_AI_RELEASE_ENABLED=false

# Formal browser origin and generated invitation links.
PUBLIC_WEB_ORIGIN=https://zhixingark.cn
PUBLIC_SITE_ORIGIN=https://zhixingark.cn
