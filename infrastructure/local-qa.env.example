# Copy to ../.env.production, restrict permissions to 600, and replace every placeholder.
RELEASE_TAG=local-qa
SITE_ADDRESS=:80
BIND_ADDRESS=127.0.0.1
PUBLIC_HTTP_PORT=4610
PUBLIC_HTTPS_PORT=4643
POSTGRES_PASSWORD=replace-with-url-safe-random-secret
DATABASE_URL=postgresql://suite:replace-with-url-safe-random-secret@postgres:5432/suite
PORT=4600
WORKER_HEALTH_PORT=4602
WEB_ORIGIN=http://127.0.0.1:4610
AI_ENCRYPTION_KEY=replace-with-base64-encoded-32-random-bytes
AI_PROVIDER_ALLOWED_HOSTS=your-provider.example
