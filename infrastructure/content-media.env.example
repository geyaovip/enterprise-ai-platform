# Brand content uses server-side Ark credentials; API and Worker share the same private media volume.
# If omitted, CONTENT_ARK_API_KEY falls back to the existing BOM_VISION_API_KEY, then ARK_API_KEY.
CONTENT_ARK_API_KEY=
CONTENT_ARK_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
CONTENT_SEEDREAM_MODEL=doubao-seedream-4-5-251128
CONTENT_MEDIA_CONFIG_VERSION=1
CONTENT_STORAGE_PATH=/var/lib/suite/content
# Bump configuration version when changing the credential account/endpoint/capability binding.
# Queued work never silently switches binding; saved results remain recoverable after a change.
# Preview and export use the bundled OFL Noto font; no system-font fallback.

# Brand media tools. Configure on API and Worker using credentials for each service.
MEDIAKIT_API_KEY=
CONTENT_DOUBAO_VOICE_API_KEY=
