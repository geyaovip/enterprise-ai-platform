# Use Node 24.16+; install the pinned official package in the ignored runtime directory.
OPENCLAW_MODEL_BASE_URL=https://your-model-provider.example/v1
OPENCLAW_MODEL_ID=your-model-id
OPENCLAW_MODEL_API_KEY=
OPENCLAW_MODEL_API=openai-completions
OPENCLAW_PORT=18790
# User-selected RAGFlow Cloud (not a local deployment).
RAGFLOW_BASE_URL=https://cloud.ragflow.io
RAGFLOW_API_KEY=
RAGFLOW_EMBEDDING_MODEL=
INFRASTRUCTURE_ALLOWED_HOSTS=127.0.0.1,cloud.ragflow.io
