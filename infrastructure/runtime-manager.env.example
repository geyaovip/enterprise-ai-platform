# Private lifecycle controller environment; model keys live in encrypted platform
# settings or tenant-owned private profiles, never in this example.
RUNTIME_MANAGER_ROOT=/opt/apaas/enterprise-ai-platform/shared/runtime-manager
RUNTIME_MANAGER_SOCKET=/run/suite-runtime/control.sock
RUNTIME_MANAGER_NETWORK=enterprise-ai-platform_default
RUNTIME_MAX_ACTIVE=2
RUNTIME_MEMBER_CONCURRENT=2
RUNTIME_IDLE_SECONDS=900
RUNTIME_GATEWAY_CPUS=2
RUNTIME_GATEWAY_MEMORY_MB=1536
AI_PROVIDER_ALLOWED_HOSTS=ark.cn-beijing.volces.com

# Optional CRM agent model; does not change ERP/management agents.
CRM_MODEL_ID=doubao-seed-2-1-lite-260915

# Optional accepted MES model; independent from ERP and CRM.
MES_MODEL_ID=doubao-seed-evolving
