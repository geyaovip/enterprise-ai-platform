# API + Worker, server-owned Ark credential. Never commit the actual key.
# Requires NATIVE_AI_MODEL_ENABLED=true, MES_AI_RELEASE_ENABLED=true,
# tenant AI entitlement and mes.bom.write / mes.material.read / mes.ai.use.
BOM_VISION_ENABLED=false
BOM_VISION_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
BOM_VISION_API_KEY=
# Optional cost controls; defaults preserve the existing production policy.
# true: GLM first even for dense/distorted pages; only malformed/unreadable output
# triggers automatic Kimi. Density, printed gaps/duplicates and ordinary missing
# fields stay visible for human review without another paid pass.
BOM_VISION_GLM_FIRST=false
# false: all pages use GLM, no automatic/manual Kimi call; unresolved facts go to human review.
BOM_VISION_KIMI_ENABLED=true
# These flags never override chat models, bypass manual review or enable repeated requests.
# Sources use the existing persistent KNOWLEDGE_STORAGE_DIR/bom-vision path,
# isolated from indexed documents, owner-scoped and retained for seven days.
